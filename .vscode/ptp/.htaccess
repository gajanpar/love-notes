# ----------------------------------------------------------------------
# SPKTAD Pelindo Cirebon - Root Web Server Hardening & Routing
# ----------------------------------------------------------------------

<IfModule mod_rewrite.c>
    RewriteEngine On

    # Block access to hidden files and sensitive extensions
    RewriteRule (^|/)\.(?!well-known) - [F]
    RewriteRule \.(env|sqlite|db|log|git|md|yml|yaml|json|lock)$ - [F,L,NC]
    RewriteRule ^(database|storage/app/backups|bootstrap/cache|tests|app|config|routes) - [F,L,NC]

    # Redirect all incoming traffic to public directory
    RewriteCond %{REQUEST_URI} !^/public/
    RewriteRule ^(.*)$ public/$1 [L]
</IfModule>

# Disable Directory Browsing
Options -Indexes
