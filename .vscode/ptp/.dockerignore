# Git and version control
.git
.github
.gitignore
.gitattributes

# Development agent worktrees and scratchpads
.agents
scratch
.vscode

# Node and frontend build dependencies (assets are pre-compiled in public/assets/)
node_modules
npm-debug.log
yarn-error.log

# Testing infrastructure and result caches
tests
phpunit.xml
.phpunit.result.cache
run_tests.ps1
run_tests.sh

# Environment and secrets (injected via PaaS runtime environment variables)
.env
.env.*
!.env.example

# Local SQLite databases (created fresh on container boot via entrypoint)
database/*.sqlite
database/*.sqlite-journal
database/*.sqlite-wal
database/*.sqlite-shm
*.sqlite
*.sqlite*

# Logs and transient runtime cache
storage/logs/*.log
storage/framework/cache/data/*
storage/framework/sessions/*
storage/framework/views/*
storage/app/backups/*

# Documentation files
docs/
*.md
!README.md
