# ----------------------------------------------------------------------
# SPKTAD Pelindo Cirebon - Universal Apache / InfinityFree Root Configuration
# ----------------------------------------------------------------------

<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /

    # 1. Force HTTPS (Reverse-Proxy Safe for InfinityFree, Cloudflare, & Shared Hosts)
    # Checks X-Forwarded-Proto to prevent ERR_TOO_MANY_REDIRECTS behind reverse proxies
    RewriteCond %{HTTP:X-Forwarded-Proto} !https
    RewriteCond %{HTTPS} off
    RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

    # 2. Security Hardening: Block Direct Access to Sensitive Files and Directories
    # Whitelist ACME SSL challenges and Laravel public directory assets
    RewriteCond %{REQUEST_URI} !^/\.well-known/
    RewriteCond %{REQUEST_URI} !^/\.vscode/ptp/public/
    RewriteRule (^|/)\. - [F,L]

    # Block sensitive configuration, database, log, source control, and deployment files
    RewriteRule \.(env|sqlite|db|log|git|md|yml|yaml|json|lock|sh|bak|dist)$ - [F,L,NC]

    # Block internal application source code, configuration, and storage directories
    RewriteRule (^|/)(\.vscode/ptp/)?(app|bootstrap|config|database|resources|routes|storage|tests|vendor) - [F,L,NC]

    # 3. Transparent Routing to Laravel Public Directory
    # Case A: Standard Repository Root in Document Root (Application located at public/)
    RewriteCond %{DOCUMENT_ROOT}/public -d
    RewriteCond %{REQUEST_URI} !^/public/
    RewriteRule ^(.*)$ public/$1 [L,QSA]

    # Case B: Nested Monorepo Root in Document Root (Application located at .vscode/ptp/public)
    RewriteCond %{DOCUMENT_ROOT}/.vscode/ptp/public -d
    RewriteCond %{REQUEST_URI} !^/\.vscode/ptp/public/
    RewriteRule ^(.*)$ .vscode/ptp/public/$1 [L,QSA]
</IfModule>

# Disable Directory Browsing
Options -Indexes

# Fallback Security via FilesMatch (Apache 2.4)
<FilesMatch "^\.(env|git|htaccess)">
    Require all denied
</FilesMatch>
<FilesMatch "\.(sqlite|db|log|key)$">
    Require all denied
</FilesMatch>
